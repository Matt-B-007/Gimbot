<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Matt_B_007.Gimbot</id>
  <name>Gimbot</name>
  <summary>Control OBSBOT cameras on Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      An unofficial control app for OBSBOT Tiny 2 cameras: AI tracking, gimbal
      aiming, zoom, presets, tracking areas, voice commands and every image
      setting, with a live preview. Not affiliated with OBSBOT or Remo Tech.
    </p>
  </description>
  <developer id="io.github.matt_b_007">
    <name>Matt-B-007</name>
  </developer>
  <url type="homepage">https://github.com/Matt-B-007/Gimbot</url>
  <url type="bugtracker">https://github.com/Matt-B-007/Gimbot/issues</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">io.github.Matt_B_007.Gimbot.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <provides>
    <binary>gimbot</binary>
    <binary>gimbotctl</binary>
    <modalias>usb:v3564p*</modalias>
  </provides>
